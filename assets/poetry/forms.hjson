      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABA ABA ABA ABA ABA ABAA"
      stanzas: 6
      lines_per_stanza: 0
    }
    {
      form: pantoum
      desc: "interlocking quatrains: lines 2 and 4 recur as 1 and 3 of the next"
