      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABAB BCBC CDCD"
      stanzas: 0
      lines_per_stanza: 4
    }
    {
      form: terza_rima
      desc: "chained tercets: ABA BCB CDC …"
      metre: iambic
      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABA BCB CDC DED"
