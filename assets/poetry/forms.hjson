{
  // POEM-1 — the built-in poetry forms library. Each entry is a language-neutral
  // `poem:` template; the CLI applies per-language tuning (French → syllabic +
  // mute-e; Russian → pyrrhic allowance + final stress) and sets `language`.
  // `desc` is a one-line summary for `inkhaven poetry forms` (not part of the
  // emitted poem: block). NB: HJSON quoteless strings run to end of line — one
  // field per line, no inline commas.
  forms: [
    {
      form: sonnet
      desc: "14 lines of iambic pentameter (generic English scheme)"
      metre: iambic
      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABAB CDCD EFEF GG"
      stanzas: 0
      lines_per_stanza: 0
    }
    {
      form: petrarchan_sonnet
      desc: "Italian sonnet: octave (ABBAABBA) + sestet (CDECDE)"
      metre: iambic
      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABBAABBA CDECDE"
      stanzas: 2
      lines_per_stanza: 0
    }
    {
      form: shakespearean_sonnet
      desc: "English sonnet: 3 quatrains + a couplet, volta near line 12"
      metre: iambic
      feet: 5
      metre_tradition: accentual_syllabic
      rhyme_scheme: "ABAB CDCD EFEF GG"
      stanzas: 4
      lines_per_stanza: 0
    }
    {
      form: haiku
      desc: "3 lines, 5-7-5 syllables, unrhymed"
      metre: syllabic
      feet: 0
      metre_tradition: syllabic
      rhyme_scheme: "- - -"
      stanzas: 1
      lines_per_stanza: 3
    }
    {
      form: senryuu
      desc: "haiku form (5-7-5) on human nature rather than the seasons"
      metre: syllabic
      feet: 0
      metre_tradition: syllabic
      rhyme_scheme: "- - -"
      stanzas: 1
      lines_per_stanza: 3
    }
    {
      form: tanka
      desc: "5 lines, 5-7-5-7-7 syllables, unrhymed"
      metre: syllabic
      feet: 0
      metre_tradition: syllabic
      rhyme_scheme: "- - - - -"
      stanzas: 1
      lines_per_stanza: 5
    }
    {
      form: ghazal
      desc: "autonomous couplets sharing a radif; a signature in the closing maqta"
      metre: free
      feet: 0
      metre_tradition: free
      rhyme_scheme: "AA -A -A -A -A"
      stanzas: 0
      lines_per_stanza: 2
      signature_word: ""
    }
    {
      form: villanelle
      desc: "19 lines: 5 tercets + a quatrain, two refrains on a schedule"
